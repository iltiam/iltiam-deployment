        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iltiam_ai_job_duration_seconds_bucket{env=\"$env\", mode=\"async\", outcome=\"completed\"}[15m])))",
          "refId": "C",
          "legendFormat": "analysis p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
