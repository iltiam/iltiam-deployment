{
  "uid": "iltiam-ai-drift",
  "title": "ILTIAM AI: drift (weekly)",
  "description": "Weekly drift of the AI service from production aggregates (iltiam-ai-service#151, SRS 5.6.3): confidence and decision mix vs clean val, reasons and wound area vs the 4 weeks before.",
  "tags": [
    "iltiam",
    "ai",
    "drift"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-35d",
    "to": "now"
  },
  "refresh": "1h",
  "timezone": "Asia/Riyadh",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(iltiam_ai_decisions_total, env)",
          "refId": "env"
        },
        "definition": "label_values(iltiam_ai_decisions_total, env)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Drift alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", alertname=~\"Ai.*Drift\", env=\"$env\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{reason}} {{model}}",
        "step": "1h"
      }
    ]
  },
  "links": [
    {
      "title": "Runbook: drift alert",
      "type": "link",
      "targetBlank": true,
      "url": "https://github.com/iltiam/iltiam-ai-service/blob/main/docs/drift-monitoring.md"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Drift scores: 7-day windows, alerts above 0.15 for 6 h (docs/drift-monitoring.md)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Analyses, last 7 days",
      "description": "Completed analyses (every decision). Alerts need 50 or more.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(iltiam_ai:analyses:count_7d{env=\"$env\"}[1h])",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Analyses, 4 weeks before",
      "description": "Completed analyses in the 28 days before this week: the reference of the reason and area alerts. Empty until Prometheus holds 35 days.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(iltiam_ai:analyses:count_prev28d{env=\"$env\"}[1h])",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Measured wounds, last 7 days",
      "description": "Completed analyses that reported a wound area.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "last_over_time(iltiam_ai:wound_area:count_7d{env=\"$env\"}[1h])",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
