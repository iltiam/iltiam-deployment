    {
      "type": "timeseries",
      "title": "Decisions per week",
      "description": "Completed analyses by decision status, each week (RETAKE_REQUIRED included).",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1w",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (increase(iltiam_ai_decisions_total{env=\"$env\"}[$__interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
