    {
      "type": "row",
      "title": "Segmentation confidence",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Confidence per week (p10, median)",
      "description": "Weekly quantiles from the bucket counts (bucket resolution: 0.01 to 0.05 above 0.85).",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1w",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, model) (increase(iltiam_ai_segmentation_confidence_bucket{env=\"$env\"}[$__interval])))",
          "legendFormat": "median {{model}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.1, sum by (le, model) (increase(iltiam_ai_segmentation_confidence_bucket{env=\"$env\"}[$__interval])))",
          "legendFormat": "p10 {{model}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
