# Compose interpolation for one environment's project: /srv/iltiam/env/<staging|production>/infra.env
# Runbook: docs/runbooks/04-secrets.md. Inventory, owners and rotation: docs/secrets.md.
#
# Passed as `docker compose --env-file .../infra.env` (scripts/compose.sh). compose.yml hands each value only to the
# container that needs it (scripts/check-compose.sh checks it); this file is never mounted into an app container.
# This template holds NO values. Each NAME= line is filled from the GitHub Environment secret of the same name by
# scripts/render-env.sh. The comment line above each variable says:
#   kind   secret (Environment secret) | var (Environment variable)
#   need   required | prod-required (staging may leave it out) | optional (left out when unset) | staging-only

# --- Cloudflare Tunnel (Runbook 3, #9) -------------------------------------------------------------------------------
# secret, required: token of this environment's tunnel (iltiam-staging or iltiam-prod); cloudflared's TUNNEL_TOKEN.
CF_TUNNEL_TOKEN=

# --- Postgres (one container per environment, databases iltiam and iltiam_ai) ---------------------------------------
# secret, required: Postgres superuser password; only the init scripts and maintenance use it.
POSTGRES_PASSWORD=
# secret, required: password of the backend's database role iltiam; compose builds DATABASE_URL from it.
BACKEND_DB_PASSWORD=
# secret, required: password of the AI service's database role iltiam_ai; compose passes it as PGPASSWORD.
AI_DB_PASSWORD=

# --- Model weights (AI-07) ------------------------------------------------------------------------------------------
# secret, required: fine-grained PAT, Contents read-only on iltiam-ai-service; weights-init's GITHUB_TOKEN.
WEIGHTS_READ_TOKEN=
