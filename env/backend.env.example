# Backend container environment (web, worker, beat, migrate): /srv/iltiam/env/<staging|production>/backend.env
# Runbook: docs/runbooks/04-secrets.md. Inventory, owners and rotation: docs/secrets.md.
#
# This template holds NO values. Each NAME= line is filled from the GitHub Environment secret or variable of the
# same name by scripts/render-env.sh. The comment line above each variable says:
#   kind   secret (Environment secret) | var (Environment variable)
#   need   required | prod-required (staging may leave it out) | optional (left out when unset) | staging-only
#
# Set by compose.yml (#2), not here: DATABASE_URL (from BACKEND_DB_PASSWORD in infra.env), REDIS_URL,
# CELERY_BROKER_URL, CELERY_RESULT_BACKEND, CACHE_URL, AI_SERVICE_URL, FCM_CREDENTIALS_FILE, WEB_CONCURRENCY,
# CELERY_CONCURRENCY, FORWARDED_ALLOW_IPS. DJANGO_SETTINGS_MODULE is baked into the image.
# Never set on a deployment: DEBUG, OTP_DEV_ECHO, LOAD_TEST_SEED_ENABLED, PUBLIC_BASE_URL, MINIO_*, TWILIO_*.

# --- Core -----------------------------------------------------------------------------------------------------
# var, required: staging or production; picks what the production settings allow.
ENVIRONMENT=
# secret, required: Django signing key (sessions, password-reset and activation links); scripts/bootstrap-secrets.sh.
SECRET_KEY=
# secret, required: signs the API's access and refresh tokens; scripts/bootstrap-secrets.sh.
JWT_SECRET_KEY=
# secret, required: Fernet key for authenticator secrets and message bodies; NEVER rotate, escrow it in Bitwarden.
FIELD_ENCRYPTION_KEY=
# var, required: the API host name, staging-api.iltiamcare.com or api.iltiamcare.com.
ALLOWED_HOSTS=
# var, required: the web app's origin, https://staging-app.iltiamcare.com or https://app.iltiamcare.com.
CORS_ALLOWED_ORIGINS=
# var, required: same origin as CORS_ALLOWED_ORIGINS (CSRF check for the admin and cookie requests).
CSRF_TRUSTED_ORIGINS=
# var, required: proxies in front of the backend, for per-IP rate limits; 1 (Cloudflare's edge; Runbook 3, section 8).
NUM_PROXIES=
# var, optional: log level, INFO when unset.
LOG_LEVEL=
# var, optional: HSTS max-age in seconds; one week when unset.
SECURE_HSTS_SECONDS=
# var, optional: True puts the domain on browsers' HSTS preload list (hard to undo); off when unset.
SECURE_HSTS_PRELOAD=
# var, optional: /api/schema/ and /api/docs/; on in staging when unset, never served in production.
API_DOCS_ENABLED=

# --- Object storage (OCI, Runbook 8, DEP-02) ------------------------------------------------------------------
# var, required: S3-compatible endpoint, https://<NAMESPACE>.compat.objectstorage.me-riyadh-1.oraclecloud.com.
STORAGE_ENDPOINT_URL=
# var, optional: host that download links are signed for; STORAGE_ENDPOINT_URL when unset.
STORAGE_PUBLIC_ENDPOINT_URL=
# var, required: me-riyadh-1.
STORAGE_REGION=
# secret, required: OCI Customer Secret Key, access key part, of this environment's storage user.
STORAGE_ACCESS_KEY=
# secret, required: OCI Customer Secret Key, secret part (shown once by OCI).
STORAGE_SECRET_KEY=
# var, required: wound photos bucket, e.g. iltiam-staging-wound-images.
STORAGE_BUCKET_WOUND_IMAGES=
# var, required: segmentation masks bucket, e.g. iltiam-staging-wound-masks.
STORAGE_BUCKET_WOUND_MASKS=
# var, required: generated PDF reports bucket, e.g. iltiam-staging-reports.
STORAGE_BUCKET_REPORTS=
# var, required: prescriptions bucket, e.g. iltiam-staging-prescriptions.
STORAGE_BUCKET_PRESCRIPTIONS=
# var, required: profile photos bucket, e.g. iltiam-staging-profile-photos.
STORAGE_BUCKET_PROFILE_PHOTOS=
# var, optional: download link lifetime in seconds; 900 (the 15-minute maximum) when unset.
STORAGE_PRESIGNED_GET_EXPIRES=
# var, optional: upload link lifetime in seconds; 900 when unset.
STORAGE_PRESIGNED_PUT_EXPIRES=

# --- AI service -------------------------------------------------------------------------------------------------
# secret, required: shared token for backend -> AI calls; the same Environment secret also fills ai.env.
AI_SERVICE_TOKEN=
# var, optional: True lets the AI service upload masks by presigned URL (needs https storage); TO CONFIRM True.
AI_MASK_UPLOAD_ENABLED=
# var, optional: lifetime in seconds of that mask upload URL; 600 when unset.
AI_MASK_UPLOAD_EXPIRES_S=
# var, optional: seconds per HTTP call to the AI service; 10 when unset.
AI_HTTP_TIMEOUT_S=
# var, optional: seconds after which a job stuck in processing counts as stale; 120 when unset.
AI_STALE_PROCESSING_GRACE_S=

# --- Sign-in, CAPTCHA and delivery ------------------------------------------------------------------------------
# var, prod-required: apps.notifications.sms.AuthenticaSMSBackend; staging may keep the console until DEP-14.
SMS_BACKEND=
# secret, prod-required: Authentica API key of this environment (Runbook 12, DEP-14).
AUTHENTICA_API_KEY=
# var, prod-required: the sender name Authentica approved, e.g. ILTIAM (not secret).
AUTHENTICA_SENDER_NAME=
# var, optional: Authentica WhatsApp template id; the account's default template when unset.
AUTHENTICA_WHATSAPP_TEMPLATE_ID=
# var, optional: seconds after which the app offers the other code channels; 30 when unset.
OTP_FALLBACK_AFTER_S=
# secret, required: Cloudflare Turnstile secret key of this environment's widget (CAPTCHA after 3 failures).
TURNSTILE_SECRET_KEY=
# var, prod-required: apps.notifications.push.FCMPushBackend; staging may keep the console until DEP-13.
PUSH_BACKEND=
# var, prod-required: django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=
# var, prod-required: SMTP host, OCI Email Delivery's Riyadh endpoint (Runbook 2, section 11; pending provider).
EMAIL_HOST=
# var, prod-required: SMTP port, normally 587.
EMAIL_PORT=
# var, optional: STARTTLS on the SMTP connection; True when unset.
EMAIL_USE_TLS=
# secret, prod-required: SMTP user name.
EMAIL_HOST_USER=
# secret, prod-required: SMTP password or API key.
EMAIL_HOST_PASSWORD=
# var, prod-required: sender shown on emails, e.g. ILTIAM <no-reply@iltiamcare.com>.
DEFAULT_FROM_EMAIL=
# var, required: page behind the emailed activation link, https://app.iltiamcare.com/activate; path TO CONFIRM (WEB-05).
ACTIVATION_LINK_BASE_URL=
# var, optional: name shown in authenticator apps; set "ILTIAM Staging" on staging so the two are told apart.
TOTP_ISSUER=

# --- Rate limits and retention (optional tuning; defaults in the backend's .env.example) ------------------------
# var, optional: anonymous requests per IP, 60/min when unset.
THROTTLE_ANON=
# var, optional: sign-in and password steps per IP, 20/min when unset.
THROTTLE_AUTH=
# var, optional: uploads per user, 60/hour when unset.
THROTTLE_UPLOADS=
# var, optional: days before messages are archived, 365 when unset.
MESSAGE_RETENTION_DAYS=

# --- Staging only (production refuses these at start-up) --------------------------------------------------------
# var, staging-only: reserved test numbers whose codes are echoed for smoke tests; printed by manage.py seed_staging.
OTP_DEV_ECHO_NUMBERS=
# secret, staging-only: password of the seeded staging test accounts (must meet the password policy).
STAGING_TEST_PASSWORD=
# var, staging-only: True lets manage.py seed_demo write demo patients on staging.
DEMO_SEED_ENABLED=
