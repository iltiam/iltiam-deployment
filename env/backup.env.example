# Nightly backup and weekly restore test (scripts/backup.sh, scripts/restore-test.sh): /srv/iltiam/env/<env>/backup.env
# Runbook: docs/runbooks/06-backups.md (issue #8). Inventory, owners and rotation: docs/secrets.md.
#
# This template holds NO values. Each NAME= line is filled from the GitHub Environment secret or variable of the
# same name by scripts/render-env.sh. The comment line above each variable says:
#   kind   secret (Environment secret) | var (Environment variable)
#   need   required | prod-required (staging may leave it out) | optional (left out when unset) | staging-only
#
# No container reads this file: only the two scripts, run by systemd on the VM as deploy. They read it as data
# (NAME='value' lines), never run it, and stop with the missing names when one they need is not set. Staging may
# leave everything out until Runbook 6 is done, so staging deploys keep working; production refuses to deploy
# without it, because production takes no real patient data before its backups work (go-live checklist).

# --- The backups bucket (Runbook 6, sections 3 and 4) -----------------------------------------------------------
# The backup user can create and read objects in its own -backups bucket only: no delete, no overwrite.
# secret, prod-required: Customer Secret Key, access key part, of the iltiam-<staging|prod>-backup user.
BACKUP_STORAGE_ACCESS_KEY=
# secret, prod-required: the same key's secret part.
BACKUP_STORAGE_SECRET_KEY=
# The same Environment secret and variable also fill backend.env (Runbook 8, section 11).
# secret, prod-required: https://<NAMESPACE>.compat.objectstorage.me-riyadh-1.oci.customer-oci.com.
STORAGE_ENDPOINT_URL=
# var, prod-required: me-riyadh-1.
STORAGE_REGION=

# --- Encryption (age, Runbook 6, section 7) ----------------------------------------------------------------------
# Losing the private key makes every backup useless: it is escrowed in Bitwarden (Runbook 4, section 11).
# var, prod-required: the environment's age public key, age1...; every backup is encrypted to it.
BACKUP_AGE_RECIPIENT=
# secret, prod-required: the matching private key, AGE-SECRET-KEY-1...; the restore test decrypts with it.
BACKUP_AGE_IDENTITY=

# --- The dead-man checks (Runbook 6, section 5) ------------------------------------------------------------------
# Secrets, because anyone holding a ping URL could silence its alert.
# secret, prod-required: ping URL of this environment's nightly check (period 1 day, grace 2 hours).
BACKUP_PING_URL=
# secret, prod-required: ping URL of this environment's restore-test check (Fridays 04:00, grace 3 hours).
BACKUP_RESTORE_PING_URL=
