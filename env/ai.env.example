# AI service container environment (ai-api, ai-worker, ai-beat): /srv/iltiam/env/<staging|production>/ai.env
# Runbook: docs/runbooks/04-secrets.md. Inventory, owners and rotation: docs/secrets.md.
#
# This template holds NO values. Each NAME= line is filled from the GitHub Environment secret or variable of the
# same name by scripts/render-env.sh. The comment line above each variable says:
#   kind   secret (Environment secret) | var (Environment variable)
#   need   required | prod-required (staging may leave it out) | optional (left out when unset) | staging-only
#
# Set by compose.yml (Runbook 5, #2), not here: CELERY_BROKER_URL, CELERY_RESULT_BACKEND, AI_CACHE_URL (Redis
# databases 3, 4 and 5; the backend has 0 and 2), PGHOST, PGPORT, PGDATABASE=iltiam_ai, PGUSER=iltiam_ai, PGPASSWORD
# (from AI_DB_PASSWORD in infra.env), ILTIAM_TORCH_THREADS=2 and OMP_NUM_THREADS=2 (the 2-OCPU VM, ADR-0004).
# weights-init gets its GITHUB_TOKEN from WEIGHTS_READ_TOKEN in infra.env; the api and worker never see it.
# Never set on a deployment: ILTIAM_ALLOW_FAKE_MODEL, ILTIAM_FAKE_DELAY_S, ILTIAM_FAKE_DELAY_UNINTERRUPTIBLE,
# MASK_UPLOAD_ALLOW_HTTP, DJANGO_DEBUG, ILTIAM_DEVICE (CPU is the default; the variable has a known bug).

# --- Core -------------------------------------------------------------------------------------------------------
# secret, required: the AI service's own Django key, not the backend's; scripts/bootstrap-secrets.sh.
DJANGO_SECRET_KEY=
# secret, required: shared token for backend -> AI calls; the same Environment secret also fills backend.env.
AI_SERVICE_TOKEN=
# var, required: 0 turns off the synchronous analyze path (the backend polls jobs); value TO CONFIRM.
ALLOW_SYNC=
# var, optional: log level, INFO when unset.
AI_LOG_LEVEL=

# --- Capacity on the shared VM (issue AI-07, Runbook 5) ----------------------------------------------------------
# var, required: gunicorn processes in ai-api, 1 per environment (each loads ~1.2 GB).
AI_API_WORKERS=
# var, required: Celery prefork processes in ai-worker, 1 per environment.
AI_WORKER_CONCURRENCY=
# var, optional: seconds before a task is asked to stop; 30 when unset.
AI_TASK_SOFT_TIME_LIMIT_S=
# var, optional: seconds before a task is killed; 40 when unset.
AI_TASK_TIME_LIMIT_S=
# var, optional: Redis visibility timeout in seconds for unacknowledged tasks; 300 when unset.
CELERY_VISIBILITY_TIMEOUT_S=

# --- Models --------------------------------------------------------------------------------------------------------
# var, required: 0 keeps ALG-03 tissue classification off (ADR-0004); 1 needs its weights.
ILTIAM_TISSUE_ENABLED=
# var, optional: segmentation model, segformer-b2 when unset; production refuses the fake ones.
ILTIAM_SEG_MODEL=
# var, optional: IANA zone that measurement dates use; Asia/Riyadh when unset, must match the backend.
ILTIAM_SERIES_TZ=
# var, optional: 1 keeps photos pending clinician review out of trends and risk; 1 when unset.
ILTIAM_EXCLUDE_MANUAL_REVIEW_FROM_TREND=

# --- Mask upload, retention and limits -----------------------------------------------------------------------------
# secret, required: mask upload host, <NAMESPACE>.compat.objectstorage.me-riyadh-1.oci.customer-oci.com (Runbook 8).
MASK_UPLOAD_ALLOWED_HOSTS=
# var, optional: hours before a job, its image and mask are deleted (PDPL); 24 when unset.
AI_JOB_TTL_HOURS=
# var, optional: largest image in MB; 10 when unset.
MAX_IMAGE_MB=
# var, optional: requests per service token, e.g. 120/min (the default).
AI_THROTTLE_RATE=
