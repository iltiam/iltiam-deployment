# The production Environment's VARIABLES (not secrets), ready for scripts/set-env-vars.sh (issue #36).
# Public on purpose: host names, bucket names and backends, the same kind of values staging's variables hold.
# Secrets are never here: they go in with `gh secret set` (docs/production-environment.md, section 3).
# A value `TO-FILL` or `TO-DECIDE` is skipped by the script until someone writes the real one here in a reviewed PR.
#
# Mirrors staging's variables (2026-11-23) with production's names. Left out on purpose: OTP_DEV_ECHO_NUMBERS,
# STAGING_TEST_PASSWORD and DEMO_SEED_ENABLED (production refuses them at start), API_DOCS_ENABLED (never in
# production), AUTHENTICA_SMS_CODE_MODE and its template ids (production sends codes with its own sender name).

# --- backend.env ---------------------------------------------------------------------------------------------------
ENVIRONMENT=production
ALLOWED_HOSTS=api.iltiamcare.com
CORS_ALLOWED_ORIGINS=https://app.iltiamcare.com
CSRF_TRUSTED_ORIGINS=https://app.iltiamcare.com
NUM_PROXIES=1
SECURE_HSTS_SECONDS=15552000
STORAGE_REGION=me-riyadh-1
STORAGE_BUCKET_WOUND_IMAGES=iltiam-prod-wound-images
STORAGE_BUCKET_WOUND_MASKS=iltiam-prod-wound-masks
STORAGE_BUCKET_REPORTS=iltiam-prod-reports
STORAGE_BUCKET_PRESCRIPTIONS=iltiam-prod-prescriptions
STORAGE_BUCKET_PROFILE_PHOTOS=iltiam-prod-profile-photos
AI_MASK_UPLOAD_ENABLED=True
SMS_BACKEND=apps.notifications.sms.AuthenticaSMSBackend
# Needs an approved sender name (a Commercial Registration), or a decision to run production another way (Runbook 12,
# section 12). Production settings refuse to start without it.
AUTHENTICA_SENDER_NAME=TO-DECIDE
PUSH_BACKEND=apps.notifications.push.FCMPushBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.email.me-riyadh-1.oci.oraclecloud.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=ILTIAM <no-reply@iltiamcare.com>
ACTIVATION_LINK_BASE_URL=https://app.iltiamcare.com/activate
TOTP_ISSUER=ILTIAM
# true makes the daily retention job delete (docs/privacy/retention.md, "Checking it"); decided with #36, after the
# dry-run counts are compared on production. Only true or false (scripts/check-env.sh).
RETENTION_ENFORCE=TO-DECIDE

# --- ai.env --------------------------------------------------------------------------------------------------------
ALLOW_SYNC=0
AI_API_WORKERS=1
AI_WORKER_CONCURRENCY=1
ILTIAM_TISSUE_ENABLED=0

# --- web.env -------------------------------------------------------------------------------------------------------
API_BASE_URL=https://api.iltiamcare.com
IMAGE_ORIGINS=https://*.compat.objectstorage.me-riyadh-1.oci.customer-oci.com
ILTIAM_ENVIRONMENT=production
# The site key of production's own Turnstile widget (Cloudflare → Turnstile; its secret key is already set).
TURNSTILE_SITE_KEY=TO-FILL
