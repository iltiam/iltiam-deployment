# The monitoring stack, shared by both environments: /srv/iltiam/env/monitoring/monitoring.env
# Runbook: docs/runbooks/07-monitoring.md (issue #10). Inventory, owners and rotation: docs/secrets.md.
#
# This template holds NO values. Each NAME= line is filled from the secret or variable of the same name in the GitHub
# Environment `monitoring` by scripts/render-env.sh, when the deploy workflow runs with environment=monitoring. The
# comment line above each variable says:
#   kind   secret (Environment secret) | var (Environment variable)
#   need   required | optional (left out when unset)
#
# Read by scripts/monitoring.sh on the VM, as data (NAME='value' lines), never run. It passes the tunnel token and
# Grafana's password to Compose for interpolation, and writes the alert settings into Alertmanager's configuration
# (mode 600). No container gets this whole file. Staging's and production's deploys never write it.

# --- What is monitored ---------------------------------------------------------------------------------------------
# var, required: staging, or staging,production once production runs (#36). Only these get targets and alerts.
MONITORED_ENVIRONMENTS=

# --- Grafana and its tunnel (Runbook 7, sections 4 and 5) ----------------------------------------------------------
# secret, required: the token of the Cloudflare tunnel iltiam-monitoring (its only route: grafana.iltiamcare.com).
MONITORING_TUNNEL_TOKEN=
# secret, required: Grafana's `admin` password: openssl rand -base64 24 (Runbook 7, section 5).
GRAFANA_ADMIN_PASSWORD=

# --- Where alerts go (Runbook 7, sections 6 to 8) ----------------------------------------------------------------
# Email through OCI Email Delivery, from the approved sender no-reply@iltiamcare.com (Runbook 2, section 11).
# secret, required: the SMTP username (ocid1.user...@ocid1.tenancy...) of the user iltiam-smtp-monitoring.
ALERT_SMTP_USERNAME=
# secret, required: that SMTP credential's password, shown once when it is made.
ALERT_SMTP_PASSWORD=
# secret, required: who gets the alert emails, comma-separated (a secret only because this repository is public).
ALERT_EMAIL_TO=
# secret, optional: the Discord channel's webhook URL (https://discord.com/api/webhooks/...). Email only when unset.
ALERT_DISCORD_WEBHOOK_URL=
# The Watchdog alert reaches this dead-man check every 5 minutes; it emails the team when that stops (monitoring
# itself is down).
# secret, optional: the healthchecks.io ping URL of the check iltiam-monitoring-watchdog.
ALERT_HEARTBEAT_URL=
