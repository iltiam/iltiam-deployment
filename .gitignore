# Never commit keys or credentials (SSH, OCI API, TLS).
*.pem
*.key
*.p12
*.pfx
id_*
!id_*.pub
*_oci
.oci/

# Environment files hold secrets; templates are committed as *.example (env/*.env.example).
.env
.env.*
*.env
rendered/
!.env.example
!*.example

# Secret files from third parties (docs/secrets.md): never in git, whatever the folder.
google-services.json
GoogleService-Info.plist
*service-account*.json
*.jks
*.keystore
key.properties
*.age

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# MkDocs output (mkdocs build)
site/

# scripts/dev.sh: the local stack's generated development-only keys and image overrides (issue #5).
.dev/

# scripts/loadtest.sh tokens, test photo and results (issue #22).
loadtest/.work/

# scripts/security-scan.sh reports (issue #18): they name versions and weaknesses.
security-reports/
